{
  "name": "chess-coach",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/node": "^22.13.14",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "react-router-dom": "^7.0.0",
      "@tanstack/react-query": "^5.70.0",
      "typescript": "5.9.3",
      "tailwindcss": "^4.0.0",
      "zod": "^4.3.6",
      "elysia": "^1.4.28",
      "@elysiajs/cors": "^1.4.2",
      "@elysiajs/eden": "^1.4.9",
      "drizzle-orm": "0.45.1",
      "better-auth": "^1.4.18",
      "bun-types": "^1.3.0",
      "tsdown": "^0.18.2",
      "vitest": "^1.6.0"
    }
  },
  "scripts": {
    "turbo": "turbo run",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@repo/api",
    "dev:web": "turbo run dev:web --filter=@chess-coach/desktop",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run typecheck",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "clean:all": "turbo run clean",
    "db:push": "turbo --filter=db run db:push",
    "db:studio": "turbo --filter=db run db:studio",
    "db:migrate": "turbo --filter=db run db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "turbo": "^2.9.16",
    "typescript": "catalog:"
  },
  "overrides": {
    "@sinclair/typebox": "0.34.52"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14"
}
