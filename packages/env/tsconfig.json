{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["es2022"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"moduleDetection": "force",
		"esModuleInterop": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"incremental": false,
		"types": ["bun-types"]
	},
	"include": ["./**.ts", "./**.tsx"],
	"exclude": ["node_modules", "dist"]
}
