{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["es2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"moduleDetection": "force",
		"esModuleInterop": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"incremental": false,
		"allowJs": true,
		"jsx": "preserve",
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@repo/ui/*": ["./*"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules"]
}
