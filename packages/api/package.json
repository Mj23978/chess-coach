{
  "name": "@repo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "bun run --watch src/standalone.ts",
    "start": "bun run src/standalone.ts",
    "typecheck": "tsc --noEmit",
    "clean": "git clean -xdf .cache .turbo node_modules"
  },
  "dependencies": {
    "@elysiajs/cors": "catalog:",
    "@repo/db": "workspace:*",
    "@repo/env": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/storage": "workspace:*",
    "dotenv": "^16.6.1",
    "drizzle-orm": "catalog:",
    "elysia": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "typescript": "catalog:"
  }
}
